{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sovereign Proof Certificate",
  "description": "Deterministic proof certificate binding program, obligations, evidence, and machine identity",
  "type": "object",
  "required": [
    "version",
    "certificate_id",
    "program_hash",
    "instruction_set_version",
    "verification_mode",
    "timestamp",
    "obligations",
    "evidence",
    "verifier_identity",
    "signature"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Schema version (immutable)"
    },
    "certificate_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of canonical certificate (computed by verifier)"
    },
    "program_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of bytecode (canonical encoding)"
    },
    "instruction_set_version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "ISA version, e.g. v1.0.0"
    },
    "verification_mode": {
      "type": "string",
      "enum": ["STRICT", "BOUNDED", "AUDIT"],
      "description": "Verification strategy applied"
    },
    "timestamp": {
      "type": "integer",
      "description": "Unix milliseconds (TAI, no leap seconds)"
    },
    "input_commitments": {
      "type": "object",
      "description": "Hashes of input data (matrices, vectors)",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "output_commitments": {
      "type": "object",
      "description": "Hashes of output data (results, proofs)",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "execution_trace_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of execution trace (instruction sequence + stack transitions)"
    },
    "obligations": {
      "type": "array",
      "description": "Proof obligations generated by instruction sequence",
      "items": {
        "$ref": "#/definitions/obligation"
      }
    },
    "evidence": {
      "type": "array",
      "description": "Witness data and verification results per obligation",
      "items": {
        "$ref": "#/definitions/evidence"
      }
    },
    "verifier_identity": {
      "type": "object",
      "description": "Identity of the verifying machine/process",
      "required": ["executable_hash", "verifier_version"],
      "properties": {
        "executable_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of verifier binary"
        },
        "verifier_version": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "machine_id": {
          "type": "string",
          "description": "Hardware identifier (UUID or TPM-derived)"
        },
        "attestation_level": {
          "type": "string",
          "enum": ["software-key", "hardware-tpm", "hardware-sgx"],
          "description": "Trust assurance level"
        }
      }
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$",
      "description": "Ed25519 signature (256 bits = 128 hex chars) over canonical certificate bytes"
    }
  },
  "definitions": {
    "obligation": {
      "type": "object",
      "required": ["id", "kind", "location"],
      "properties": {
        "id": {
          "type": "integer",
          "description": "Unique obligation identifier (0-indexed)"
        },
        "kind": {
          "type": "string",
          "enum": [
            "INV_OK",
            "SOLVE_OK",
            "LSTSQ_OK",
            "MATMUL_SHAPE",
            "MATMUL_BOUNDS",
            "ROW_OP_BOUNDS",
            "PIVOT_NONZERO"
          ],
          "description": "Category of proof obligation"
        },
        "params": {
          "type": "object",
          "description": "Obligation-specific parameters",
          "additionalProperties": true
        },
        "location": {
          "type": "object",
          "required": ["start_pc", "end_pc"],
          "properties": {
            "start_pc": {
              "type": "integer",
              "description": "Starting program counter"
            },
            "end_pc": {
              "type": "integer",
              "description": "Ending program counter"
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["obligation_id", "status"],
      "properties": {
        "obligation_id": {
          "type": "integer"
        },
        "status": {
          "type": "string",
          "enum": ["PASS", "FAIL", "SKIPPED"]
        },
        "witness": {
          "type": "string",
          "description": "Base64-encoded witness data (matrix, vector, or proof term)"
        },
        "compute_cycles": {
          "type": "integer",
          "description": "CPU cycles for verification (RDTSC or equivalent)"
        },
        "error_bound": {
          "type": "number",
          "description": "Max absolute error (for floating-point verification only; null for exact)"
        },
        "details": {
          "type": "string",
          "description": "Diagnostic message on FAIL"
        }
      }
    }
  }
}
